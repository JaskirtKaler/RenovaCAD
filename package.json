{
  "name": "renovacad",
  "version": "0.1.0",
  "private": true,
  "description": "A kitchen design workspace for macOS",
  "type": "module",
  "main": "./out/main/main.js",
  "packageManager": "bun@1.3.8",
  "scripts": {
    "postinstall": "bun node_modules/electron/install.js",
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "bun run typecheck && electron-vite build",
    "preview": "electron-vite preview"
  },
  "trustedDependencies": ["electron", "esbuild"],
  "dependencies": {
    "lucide-react": "^1.62.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-test-renderer": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-vite": "^6.0.0",
    "react-test-renderer": "19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
