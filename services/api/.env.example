# RenovaCAD API — example env (do not commit real keys)
# Copy to .env or export in your shell before running the service.

# Baseten Muse Spark Open
BASETEN_API_KEY=b10_gXMffhfk.9q98G9H7clGyXQJFnmINWrnZ7I47DY79
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open

# Local server
RENOVACAD_API_ADDR=127.0.0.1:8787
# Optional per-launch token for Electron → Go auth.
# When set, every /api/* request must send:
#   Authorization: Bearer <token>  or  X-RenovaCAD-Token: <token>
# Leave empty for loopback-only dev without auth.
RENOVACAD_API_TOKEN=
RENOVACAD_PROVIDER_TIMEOUT=12s
